# Ejemplo con valores FICTICIOS. Copia a .env (local) o a /etc/today/today.env
# (servidor, propietario root, permisos 640, grupo ubuntu). Nunca subas el
# archivo real al repositorio.

# Conexión del rol de la APLICACIÓN (permisos mínimos).
TODAY_DATABASE_URL=postgresql://today_app:clave-ficticia-app@10.0.0.20:5432/today?sslmode=prefer&connect_timeout=5

# Nombre del rol de la aplicación al que las migraciones otorgan permisos.
TODAY_APP_ROLE=today_app

# Clave AES-256 (32 bytes en base64) para cifrar las semillas TOTP. Genera una con:
#   uv run python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Si la pierdes, nadie podrá iniciar sesión hasta volver a enrolar el OTP.
TODAY_OTP_ENCRYPTION_KEY=CAMBIAR-genera-una-clave-con-el-comando-de-arriba

# Nombre que verá la app autenticadora.
TODAY_OTP_ISSUER=today

# SOLO en local: conexión del rol DUEÑO del esquema para `today-migrate` y
# `today-admin unlock`. En el servidor no se guarda en este archivo
# (ver README, sección "Migraciones").
# TODAY_MIGRATOR_DATABASE_URL=postgresql://today_owner:clave-ficticia-owner@127.0.0.1:5432/today

# Zona horaria para mostrar fechas en la interfaz.
TODAY_TIMEZONE=America/Bogota
